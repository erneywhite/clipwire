{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Clipwire",
  "identifier": "io.github.erneywhite.clipwire",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Clipwire",
        "url": "index.html",
        "width": 760,
        "height": 560,
        "minWidth": 640,
        "minHeight": 460,
        "visible": false,
        "center": true,
        "backgroundColor": "#1c1e22",
        "decorations": false,
        "shadow": true
      },
      {
        "label": "popup",
        "title": "Clipwire",
        "url": "index.html",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": false,
        "backgroundColor": "#1c1e22"
      },
      {
        "label": "preview",
        "title": "Clipwire",
        "url": "index.html",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": true,
        "backgroundColor": "#1c1e22"
      },
      {
        "label": "editor",
        "title": "Clipwire — редактор",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#1c1e22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src asset: http://asset.localhost; frame-src asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Erney White",
    "copyright": "Erney White",
    "category": "Utility",
    "shortDescription": "Общий буфер обмена через свой сервер",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Clipwire",
        "displayLanguageSelector": false,
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNjIzNzJCRjU0MzE5MjMKUldRakdVUDFLemRpWVYzUVNTZFBVNlFLZ1N6a0ozTUhsQVp3V3BsQks0RVJlbjA2SWo2M1VIeXEK",
      "endpoints": [
        "https://github.com/erneywhite/clipwire/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
