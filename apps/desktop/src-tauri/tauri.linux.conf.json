{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "mainBinaryName": "clipwire",
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "recommends": [
          "libgtk-layer-shell0",
          "pipewire-bin | pulseaudio-utils | alsa-utils"
        ],
        "desktopTemplate": "linux/clipwire.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/lib/libgtk-layer-shell.so.0": "/usr/lib/x86_64-linux-gnu/libgtk-layer-shell.so.0"
        }
      }
    }
  }
}
