---
import '../styles/tokens.css';
import '../styles/site.css';
import type { Strings } from '../i18n/strings';

interface Props {
  t: Strings;
}
const { t } = Astro.props;
const site = Astro.site;
const path = t.htmlLang === 'ru' ? '/ru/' : '/';
// С адресом сайта (site/.env) ссылки абсолютные, как того ждут поисковики и соцсети.
const abs = (p: string) => (site ? new URL(p, site).href : p);
const ogLocale = t.htmlLang === 'ru' ? 'ru_RU' : 'en_US';
const ogAlt = t.htmlLang === 'ru' ? 'en_US' : 'ru_RU';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="author" content="Erney White" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#141518" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {site && <link rel="canonical" href={abs(path)} />}
    <link rel="alternate" hreflang="en" href={abs('/')} />
    <link rel="alternate" hreflang="ru" href={abs('/ru/')} />
    <link rel="alternate" hreflang="x-default" href={abs('/')} />
    <link rel="alternate" type="text/plain" title="LLM summary" href={abs('/llms.txt')} />
    <link rel="sitemap" type="application/xml" href={abs('/sitemap.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Clipwire" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={abs(path)} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAlt} />
    <meta property="og:image" content={abs('/img/social-preview.png')} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Clipwire" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={abs('/img/social-preview.png')} />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
